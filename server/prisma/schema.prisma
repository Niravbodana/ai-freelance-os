generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobSource {
  UPWORK
  FREELANCER
  GURU
  REMOTE_BOARD
  OUTREACH
  MANUAL
}

enum JobStatus {
  DISCOVERED
  NOT_FEASIBLE
  PROPOSAL_DRAFTED
  PENDING_APPROVAL
  PROPOSAL_SENT
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  AWAITING_PAYMENT
  PAID
  REJECTED
  CLOSED
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  platform    JobSource
  notes       String?
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  jobs        Job[]
}

model Job {
  id           String     @id @default(cuid())
  source       JobSource
  externalUrl  String?
  title        String
  description  String
  budget       String?
  category     String
  status       JobStatus  @default(DISCOVERED)
  matchScore   Float?
  feasible     Boolean?
  feasibilityNote String?
  applyEmail   String?
  externalMeta Json?
  client       Client?    @relation(fields: [clientId], references: [id])
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  proposal     Proposal?
  deliverable  Deliverable?
  payment      Payment?
  agentRuns    AgentRun[]
}

model Proposal {
  id             String    @id @default(cuid())
  job            Job       @relation(fields: [jobId], references: [id])
  jobId          String    @unique
  draftText      String
  editedText     String?
  proposedRate   String?
  autoSent       Boolean   @default(false)
  approved       Boolean   @default(false)
  approvedAt     DateTime?
  sentAt         DateTime?
  negotiationLog String?
  createdAt      DateTime  @default(now())
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  INVOICE_SENT
  PAID
  OVERDUE
}

model Payment {
  id             String        @id @default(cuid())
  job            Job           @relation(fields: [jobId], references: [id])
  jobId          String        @unique
  provider       PaymentProvider
  amount         Float
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  invoiceUrl     String?
  dueDate        DateTime?
  lastReminderAt DateTime?
  reminderCount  Int           @default(0)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

model Deliverable {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       String   @unique
  content     String
  qaPassed    Boolean  @default(false)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
}

enum AgentType {
  HUNTER
  FEASIBILITY
  PROPOSAL
  WORKER
  DELIVERY
  PAYMENT
}

model AgentRun {
  id        String    @id @default(cuid())
  agent     AgentType
  job       Job?      @relation(fields: [jobId], references: [id])
  jobId     String?
  status    String
  log       String?
  startedAt DateTime  @default(now())
  finishedAt DateTime?
}

// Every Claude API call is logged here — this is the real, self-tracked
// source of truth for "how much have we used" and "what has it cost us",
// since the API itself doesn't expose an overall account-quota endpoint.
model UsageLog {
  id           String   @id @default(cuid())
  agent        String
  jobId        String?
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())
}

// The self-healing log: every agent failure becomes an Incident. A
// scheduled sweep retries it automatically; only once retries are
// exhausted (or there's no automatic retry path) does it get ESCALATED,
// which is the one moment a human is actually needed.
model Incident {
  id            String   @id @default(cuid())
  source        String
  jobId         String?
  message       String
  stack         String?
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  status        String   @default("OPEN") // OPEN | RESOLVED | ESCALATED
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
