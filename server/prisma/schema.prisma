generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobSource {
  UPWORK
  FREELANCER
  GURU
  REMOTE_BOARD
  OUTREACH
  MANUAL
}

enum JobStatus {
  DISCOVERED
  NOT_FEASIBLE
  PROPOSAL_DRAFTED
  PENDING_APPROVAL
  PROPOSAL_SENT
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  AWAITING_PAYMENT
  PAID
  REJECTED
  CLOSED
}

model Client {
  id                String    @id @default(cuid())
  name              String
  email             String?
  platform          JobSource
  notes             String?
  isRecurring       Boolean   @default(false)
  // Set the moment a client crosses the recurring threshold and gets
  // pitched a retainer package — see paymentAgent.js's pitchRetainer().
  // Guards against pitching the same client twice.
  retainerPitchedAt DateTime?
  createdAt         DateTime  @default(now())
  jobs              Job[]
}

model Job {
  id           String     @id @default(cuid())
  source       JobSource
  externalUrl  String?
  title        String
  description  String
  budget       String?
  category     String
  status       JobStatus  @default(DISCOVERED)
  matchScore   Float?
  feasible     Boolean?
  feasibilityNote String?
  applyEmail   String?
  externalMeta Json?
  contractSentAt DateTime?
  // A private, unguessable link clients use to check their own project's
  // status without needing a dashboard login — see routes/status.js.
  statusToken  String     @unique @default(uuid())
  client       Client?    @relation(fields: [clientId], references: [id])
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  proposal     Proposal?
  deliverable  Deliverable?
  payments     Payment[]
  agentRuns    AgentRun[]
}

model Proposal {
  id             String    @id @default(cuid())
  job            Job       @relation(fields: [jobId], references: [id])
  jobId          String    @unique
  draftText      String
  editedText     String?
  proposedRate   String?
  autoSent       Boolean   @default(false)
  approved       Boolean   @default(false)
  approvedAt     DateTime?
  sentAt         DateTime?
  negotiationLog String?
  // Performance tracking: what actually happened to this proposal, fed
  // back into future rate/pitch decisions — see services/performance.js.
  outcome        String?   // ACCEPTED | REJECTED | COUNTER_OFFER | null (no reply yet)
  outcomeAt      DateTime?
  createdAt      DateTime  @default(now())
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  INVOICE_SENT
  PAID
  OVERDUE
}

// DEPOSIT exists only for first-time non-recurring OUTREACH/MANUAL clients
// (no platform escrow, no track record — see pipelineAgent.js's deposit
// gate); every other job goes straight to a single FINAL payment, same as
// before this was added. At most one of each kind per job (@@unique).
enum PaymentKind {
  DEPOSIT
  FINAL
}

model Payment {
  id                    String        @id @default(cuid())
  job                   Job           @relation(fields: [jobId], references: [id])
  jobId                 String
  kind                  PaymentKind   @default(FINAL)
  provider              PaymentProvider
  amount                Float
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  invoiceUrl            String?
  dueDate               DateTime?
  lastReminderAt        DateTime?
  reminderCount         Int           @default(0)
  paidAt                DateTime?
  clientEmail           String?
  testimonialRequestedAt DateTime?
  createdAt             DateTime      @default(now())

  @@unique([jobId, kind])
}

model Deliverable {
  id            String    @id @default(cuid())
  job           Job       @relation(fields: [jobId], references: [id])
  jobId         String    @unique
  content       String
  qaPassed      Boolean   @default(false)
  // The revision loop: a QA fail (deliveryAgent.js) or a client-requested
  // revision post-delivery (inboxAgent.js) sets needsRevision + a reason,
  // which Worker Agent reads on its next run instead of blindly
  // regenerating from scratch. pipelineAgent.js only re-runs Delivery
  // Agent's QA check once needsRevision is cleared, so it never re-checks
  // stale, unrevised content in a loop.
  needsRevision Boolean   @default(false)
  qaFeedback    String?
  revisionNotes String?
  // Counts client-requested revisions (post-delivery REVISION_REQUEST
  // replies — see inboxAgent.js). The first REVISION_FREE_ROUNDS are
  // free and auto-looped through Worker Agent; beyond that, further
  // requests escalate to the owner instead of looping forever on a
  // client who may never be satisfied.
  revisionCount Int       @default(0)
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
}

enum AgentType {
  HUNTER
  FEASIBILITY
  PROPOSAL
  WORKER
  DELIVERY
  PAYMENT
  INBOX
  PIPELINE
  TESTIMONIAL
  LEADS
  CONTRACT
  DIGEST
  RETAINER
}

model AgentRun {
  id        String    @id @default(cuid())
  agent     AgentType
  job       Job?      @relation(fields: [jobId], references: [id])
  jobId     String?
  status    String
  log       String?
  startedAt DateTime  @default(now())
  finishedAt DateTime?
}

// Every Claude API call is logged here — this is the real, self-tracked
// source of truth for "how much have we used" and "what has it cost us",
// since the API itself doesn't expose an overall account-quota endpoint.
model UsageLog {
  id           String   @id @default(cuid())
  agent        String
  jobId        String?
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())
}

// A tiny, permanent record of what category a rejected job was — written
// the instant a job is marked NOT_FEASIBLE, independent of the Job row
// itself. Exists so digestAgent.js's growth-opportunity scan still works
// after rejected Job rows get cleaned up (hunterAgent.js deletes them 5
// minutes after rejection to keep the Jobs list from filling up with
// things that will never move again) — this is the one thing worth
// keeping from a rejected job, not the full description/title.
model RejectionLog {
  id        String   @id @default(cuid())
  category  String
  createdAt DateTime @default(now())
}

// The self-healing log: every agent failure becomes an Incident. A
// scheduled sweep retries it automatically; only once retries are
// exhausted (or there's no automatic retry path) does it get ESCALATED,
// which is the one moment a human is actually needed.
model Incident {
  id            String   @id @default(cuid())
  source        String
  jobId         String?
  message       String
  stack         String?
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  status        String   @default("OPEN") // OPEN | RESOLVED | ESCALATED
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Tracks IMAP read position per mailbox so the Inbox Agent only ever
// processes each email once, even across restarts.
model InboxState {
  id      String @id @default(cuid())
  mailbox String @unique
  lastUid Int    @default(0)
}

// Every credential except the bootstrap set (DATABASE_URL, DASHBOARD_USER/
// PASSWORD, ENCRYPTION_KEY — needed before the app can even read this
// table) lives here instead of an env var, entered through Admin Settings.
// `value` is AES-256-GCM ciphertext (see services/crypto.js), never
// plaintext — even a DB dump doesn't leak a usable key without
// ENCRYPTION_KEY too.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
