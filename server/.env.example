DATABASE_URL="postgresql://user:password@localhost:5432/ai_freelance_os"
ANTHROPIC_API_KEY="sk-ant-..."
PORT=4000

# Self-tracked Claude usage — the API has no "total account quota" endpoint,
# so cost is estimated from real token counts on every call. Check
# console.anthropic.com for your plan's actual per-token pricing and set
# these if the defaults (Sonnet-tier placeholders) are off. Budget is
# optional — the dashboard just shows usage/cost if you leave it blank.
CLAUDE_INPUT_COST_PER_MTOK=3
CLAUDE_OUTPUT_COST_PER_MTOK=15
CLAUDE_MONTHLY_BUDGET_USD=

# Email notifications (approvals needed, new feasible jobs, overdue payments, agent errors)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Payments — leave blank to run with MANUAL invoices only (tracked, no real charge link)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Freelancer.com official API — self-service at developers.freelancer.com.
# Leave blank to skip this source entirely (no partial/fake bidding).
FREELANCER_OAUTH_TOKEN=
FREELANCER_USER_ID=

# Guru.com — requires partner approval from Guru; adapter is a stub until
# you have real credentials (see agents/sources/guruCom.js).
GURU_API_KEY=
