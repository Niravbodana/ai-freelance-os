DATABASE_URL="postgresql://user:password@localhost:5432/ai_freelance_os"
ANTHROPIC_API_KEY="sk-ant-..."
PORT=4000

# REQUIRED before deploying anywhere reachable from the internet — without
# these, the dashboard and its API (job data, proposals, payment actions)
# have no login at all. Leaving them blank is fine for local dev only.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Self-tracked Claude usage — the API has no "total account quota" endpoint,
# so cost is estimated from real token counts on every call. Check
# console.anthropic.com for your plan's actual per-token pricing and set
# these if the defaults (Sonnet-tier placeholders) are off. Budget is
# optional — the dashboard just shows usage/cost if you leave it blank.
CLAUDE_INPUT_COST_PER_MTOK=3
CLAUDE_OUTPUT_COST_PER_MTOK=15
CLAUDE_MONTHLY_BUDGET_USD=

# Email notifications (approvals needed, new feasible jobs, overdue payments, agent errors)
# Gmail values: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=youraddress@gmail.com, SMTP_PASS=<16-char App Password, not your
# normal Gmail password — Google Account > Security > 2-Step Verification >
# App passwords>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Payments — leave blank to run with MANUAL invoices only (tracked, no real charge link)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Freelancer.com official API — self-service at developers.freelancer.com.
# Leave blank to skip this source entirely (no partial/fake bidding).
FREELANCER_OAUTH_TOKEN=
FREELANCER_USER_ID=

# Guru.com — requires partner approval from Guru; adapter is a stub until
# you have real credentials (see agents/sources/guruCom.js).
GURU_API_KEY=

# Inbox Agent — reads replies to proposals sent via email (REMOTE_BOARD
# apply-by-email jobs) and auto-detects accept/reject/counter-offer.
# Gmail values: IMAP_HOST=imap.gmail.com, IMAP_PORT=993, IMAP_SECURE=true,
# IMAP_USER=youraddress@gmail.com, IMAP_PASS=<same App Password as SMTP_PASS
# above — one Gmail App Password works for both>. Leave blank to skip — the
# dashboard's manual "Mark accepted/rejected" buttons still work.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
