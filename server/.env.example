# ── Bootstrap secrets — these four MUST be env vars, set once in Railway ──
# Everything else below can be set the same way (still works, unchanged)
# OR entered through the dashboard's Admin Settings page after login — that
# path stores values encrypted in the database and lets you see connected/
# disconnected status per integration. These four can't move there: the app
# needs them before it can even read the database (DATABASE_URL), before
# login exists at all (DASHBOARD_USER/PASSWORD), or as the key that unlocks
# every encrypted credential in the database (ENCRYPTION_KEY).
DATABASE_URL="postgresql://user:password@localhost:5432/ai_freelance_os"
DASHBOARD_USER=
DASHBOARD_PASSWORD=
ENCRYPTION_KEY=
PORT=4000

# ── Everything below: optional as env vars — set here, in Admin Settings ──
# ── after login, or leave entirely blank and configure later ──

# Claude API — required for every agent to actually run (feasibility,
# proposals, QA, inbox classification). The API has no "total account
# quota" endpoint, so cost is self-tracked from real per-call token counts;
# check console.anthropic.com for your plan's actual per-token pricing if
# the defaults below (Sonnet 5-tier placeholders) are off. Budget is
# optional — the dashboard just shows usage/cost if you leave it blank.
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_INPUT_COST_PER_MTOK=3
CLAUDE_OUTPUT_COST_PER_MTOK=15
CLAUDE_MONTHLY_BUDGET_USD=

# Email notifications (approvals needed, new feasible jobs, overdue payments, agent errors)
# Gmail values: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=youraddress@gmail.com, SMTP_PASS=<16-char App Password, not your
# normal Gmail password — Google Account > Security > 2-Step Verification >
# App passwords>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Payments — leave blank to run with MANUAL invoices only (tracked, no real charge link)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Freelancer.com official API — self-service at developers.freelancer.com.
# Leave blank to skip this source entirely (no partial/fake bidding).
FREELANCER_OAUTH_TOKEN=
FREELANCER_USER_ID=

# Guru.com — requires partner approval from Guru; adapter is a stub until
# you have real credentials (see agents/sources/guruCom.js).
GURU_API_KEY=

# Inbox Agent — reads replies to proposals sent via email (REMOTE_BOARD
# apply-by-email jobs) and auto-detects accept/reject/counter-offer.
# Gmail values: IMAP_HOST=imap.gmail.com, IMAP_PORT=993, IMAP_SECURE=true,
# IMAP_USER=youraddress@gmail.com, IMAP_PASS=<same App Password as SMTP_PASS
# above — one Gmail App Password works for both>. Leave blank to skip — the
# dashboard's manual "Mark accepted/rejected" buttons still work.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
