# Application
APP_NAME=AI Freelance OS
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-a-long-random-string

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ai_freelance_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=******db:5432/ai_freelance_os

# Redis
REDIS_URL=redis://redis:6379/0

# ── AI Provider selection ────────────────────────────────────────────────────
# Set to: openai | anthropic | deepseek | gemini
DEFAULT_AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── Human-in-the-loop ────────────────────────────────────────────────────────
APPROVAL_REQUIRED=true
APPROVAL_TIMEOUT_SECONDS=300

# ── Task Queue ───────────────────────────────────────────────────────────────
QUEUE_DEFAULT_NAME=tasks
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_SECONDS=5

# ── Metrics ──────────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ── Retry ────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_MIN_SECONDS=1.0
RETRY_WAIT_MAX_SECONDS=10.0

# ── Plugin system ─────────────────────────────────────────────────────────────
# Comma-separated list of enabled plugin names (empty = none)
PLUGINS_ENABLED=

# WhatsApp Business (future plugin)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
