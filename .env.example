# Application
APP_NAME=AI Freelance OS
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-a-long-random-string

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ai_freelance_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_freelance_os

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI / LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Human-in-the-loop
APPROVAL_REQUIRED=true
APPROVAL_TIMEOUT_SECONDS=300

# WhatsApp Business (future)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
